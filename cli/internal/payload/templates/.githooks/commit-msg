#!/bin/bash
# bravros-managed-commit-msg-hook v1
#
# Git commit-msg hook to enforce commit message conventions
#
# Format: <emoji> <type>[(scope)][!]: <description>
#
# Valid types & emojis are defined in templates/commit-types.txt (single source of truth).
# To see the current list:  cut -d'|' -f1,2 templates/commit-types.txt | grep -v '^#'
#
# Summary (regenerate from canonical if this falls out of sync):
#   ✨ feat  🐛 fix  📚 docs  💄 style  ♻️ refactor  ⚡ perf  🧪 test  🔧 build
#   🧹 chore  📋 plan  🔒 security  🗃️ migration  📦 deps  🚀 deploy  🤖 ci
#   🔥 remove  🩹 hotfix  🔀 merge  🔍 debug  🔙 revert  🌐 i18n
#
# Rules:
#   - NO AI signatures (Co-Authored-By: Claude, etc.)
#   - Present tense, lowercase description
#   - Subject line: warning at 50, warning at 72 (soft limit — never blocks)
#   - Blank line between subject and body
#   - No trailing period in subject
#   - Atomic commits
#

set -u

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")
# Strip comment lines (git template comments start with #)
COMMIT_MSG_CLEAN=$(echo "$COMMIT_MSG" | grep -v '^#' || true)
FIRST_LINE=$(echo "$COMMIT_MSG_CLEAN" | head -n 1)

# Colors only on a real terminal — keeps CI logs clean
if [ -t 2 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    NC='\033[0m'
else
    RED=''
    GREEN=''
    YELLOW=''
    NC=''
fi

#
# 0. Skip auto-generated commits (merges, reverts, fixup/squash)
#
if echo "$FIRST_LINE" | grep -qE "^(Merge (branch|remote-tracking|pull request|tag|commit)|Revert \"|(fixup|squash|amend)! )"; then
    exit 0
fi

# Skip empty commits (let git handle them)
if [ -z "$(echo "$COMMIT_MSG_CLEAN" | tr -d '[:space:]')" ]; then
    exit 0
fi

#
# 1. Check for AI co-author signatures and attribution footers
#
AI_PATTERNS=(
    # Catch-all: any Co-Authored-By with a noreply@ email (most AI providers use this)
    "Co-[Aa]uthored-[Bb]y:.*noreply@"
    # Provider domains
    "Co-[Aa]uthored-[Bb]y:.*@anthropic\.com"
    "Co-[Aa]uthored-[Bb]y:.*@openai\.com"
    "Co-[Aa]uthored-[Bb]y:.*@github\.com.*[Bb]ot"
    "Co-[Aa]uthored-[Bb]y:.*@google\.com.*[Aa][Ii]"
    # Specific AI / assistant names
    "Co-[Aa]uthored-[Bb]y:.*[Cc]laude"
    "Co-[Aa]uthored-[Bb]y:.*[Cc]opilot"
    "Co-[Aa]uthored-[Bb]y:.*[Gg]emini"
    "Co-[Aa]uthored-[Bb]y:.*[Gg][Pp][Tt]"
    "Co-[Aa]uthored-[Bb]y:.*[Cc]hat[Gg][Pp][Tt]"
    "Co-[Aa]uthored-[Bb]y:.*[Cc]odeium"
    "Co-[Aa]uthored-[Bb]y:.*[Tt]abby"
    "Co-[Aa]uthored-[Bb]y:.*[Cc]ursor"
    "Co-[Aa]uthored-[Bb]y:.*[Dd]evin"
    "Co-[Aa]uthored-[Bb]y:.*[Aa]ider"
    "Co-[Aa]uthored-[Bb]y:.*[Cc]line"
    "Co-[Aa]uthored-[Bb]y:.*[Rr]oo[ -]?[Cc]ode"
    "Co-[Aa]uthored-[Bb]y:.*[Cc]ody"
    "Co-[Aa]uthored-[Bb]y:.*[Cc]ontinue"
    "Co-[Aa]uthored-[Bb]y:.*[Aa]mazon [Qq]"
    "Co-[Aa]uthored-[Bb]y:.*[Cc]ode[Ww]hisperer"
    "Co-[Aa]uthored-[Bb]y:.*[Dd]eep[Ss]eek"
    "Co-[Aa]uthored-[Bb]y:.*[Gg]rok"
    "Co-[Aa]uthored-[Bb]y:.*[Mm]istral"
    "Co-[Aa]uthored-[Bb]y:.*[Ll]lama"
    "Co-[Aa]uthored-[Bb]y:.*[Ww]indsurf"
    "Co-[Aa]uthored-[Bb]y:.*[Aa]ugment"
    "Co-[Aa]uthored-[Bb]y:.*[Jj]et[Bb]rains.*[Aa][Ii]"
    "Co-[Aa]uthored-[Bb]y:.*[Zz]ed.*[Aa][Ii]"
    "Co-[Aa]uthored-[Bb]y:.*[Pp]hind"
    "Co-[Aa]uthored-[Bb]y:.*[Bb]olt"
    "Co-[Aa]uthored-[Bb]y:.*v0\.dev"
    # Agent names from your team system
    "Co-[Aa]uthored-[Bb]y:.*[Ss]pider-[Mm]an"
    "Co-[Aa]uthored-[Bb]y:.*[Ii]ron [Mm]an"
    "Co-[Aa]uthored-[Bb]y:.*[Tt]hor"
    "Co-[Aa]uthored-[Bb]y:.*[Hh]ulk"
    "Co-[Aa]uthored-[Bb]y:.*[Nn]ick [Ff]ury"
    "Co-[Aa]uthored-[Bb]y:.*[Hh]awkeye"
    "Co-[Aa]uthored-[Bb]y:.*[Jj][Aa][Rr][Vv][Ii][Ss]"
    # "Generated by/with" attribution lines
    "Generated by AI"
    "Generated by Claude"
    "Generated by GPT"
    "Generated by Copilot"
    "Generated by Cursor"
    "Generated with Claude"
    "Generated with \[Claude"
    "Generated with Cursor"
    "Generated with Copilot"
    "via Claude Code"
    # NOTE: a bare "via Cursor" was removed here — case-insensitive, it blocked ordinary
    # commits like "paginate via cursor" / "via cursor position". Attribution to Cursor is
    # already covered by the Co-Authored-By and "Generated with Cursor" entries.
    "Made with.*[Cc]opilot"
    "Powered by.*[Aa][Ii]"
    # Common robot/AI footer patterns
    "^🤖 Generated"
    "🤖 .*[Cc]o-?[Aa]uthor"
)

for pattern in "${AI_PATTERNS[@]}"; do
    if echo "$COMMIT_MSG_CLEAN" | grep -qiE "$pattern"; then
        MATCHED_LINE=$(echo "$COMMIT_MSG_CLEAN" | grep -iE "$pattern" | head -n 1)
        echo "" >&2
        echo -e "${RED}ERROR: Commit rejected — AI signature detected!${NC}" >&2
        echo "" >&2
        echo -e "  Matched line: ${YELLOW}${MATCHED_LINE}${NC}" >&2
        echo "" >&2
        echo "No AI co-author or attribution allowed. Remove the line and try again." >&2
        echo "" >&2
        exit 1
    fi
done

#
# 1b. Attribution verb x AI name, in any shape
#
# The literal-trailer list above matches only `Co-Authored-By:`. Every loosened
# variant slipped through — all 12 of these passed a live test (2026-08-21):
#   "Co-authored with Claude"   "Co-authored by Claude"   "Coauthored-by: Claude"
#   "Co-Authored-By Claude"     "Co_authored_by: Claude"  "Assisted by Claude"
#   "Assisted-By: Claude"       "Written by Claude"       "Authored by Claude Code"
#   "With help from ChatGPT"    "Pair-programmed with Copilot"
#   "Signed-off-by: Claude <noreply@anthropic.com>"
#
# Enumerating trailers does not scale. Match ANY attribution verb followed within
# 40 chars by ANY AI name instead — one rule, no cross-product. Deliberately
# strict: the standard is "no AI attribution, in any wording".
#
# Note the order dependency: "ai-powered" reads name-then-verb and does NOT match,
# while "powered by AI" does. Validated against 200 real commits: 0 false positives.
#
AI_ATTRIB='(co[-_ ]?authored?|assisted|generated|created|written|authored|made|powered|pair[-_ ]?programmed|reviewed|prompted)[-_ ]?(by|with|from)|with help from|signed[-_ ]?off[-_ ]?by|co[-_ ]?authors?[-_ ]?[:=]'
AI_NAMES='claude|chat ?gpt|gpt-?[0-9.]*|openai|anthropic|copilot|gemini|bard|codeium|windsurf|cursor|devin|aider|cline|roo[-_ ]?code|cody|tabby|amazon q|code ?whisperer|deep ?seek|grok|mistral|llama|phind|bolt\.new|v0\.dev|augment|continue\.dev|jarvis|sourcegraph|codex|junie|ai assistant|assistant ai|artificial intelligence|language model|\bllm\b|\bai\b'

if echo "$COMMIT_MSG_CLEAN" | grep -qiE "(${AI_ATTRIB})[[:space:]:<@_-]{0,4}.{0,40}(${AI_NAMES})"; then
    MATCHED_LINE=$(echo "$COMMIT_MSG_CLEAN" | grep -iE "(${AI_ATTRIB})[[:space:]:<@_-]{0,4}.{0,40}(${AI_NAMES})" | head -n 1)
    echo "" >&2
    echo -e "${RED}ERROR: Commit rejected — AI attribution detected!${NC}" >&2
    echo "" >&2
    echo -e "  Matched line: ${YELLOW}${MATCHED_LINE}${NC}" >&2
    echo "" >&2
    echo "No AI co-author or attribution allowed, in any wording. Remove the line and try again." >&2
    echo "" >&2
    exit 1
fi

#
# 2. Validate commit message format
#
# Allows optional scope and breaking-change marker:
#   ✨ feat: foo
#   ✨ feat(api): foo
#   ✨ feat(api)!: foo
#   ✨ feat!: foo
#
# Load valid patterns dynamically from the canonical commit-types.txt.
# Format: type|emoji|description — emoji becomes the pattern prefix, type the slug.
# Falls back to the hook directory heuristic if git rev-parse is unavailable.
_CANONICAL_FILE=""
if command -v git &>/dev/null; then
    _REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
    if [ -n "$_REPO_ROOT" ] && [ -f "$_REPO_ROOT/templates/commit-types.txt" ]; then
        _CANONICAL_FILE="$_REPO_ROOT/templates/commit-types.txt"
    fi
fi

# Build VALID_PATTERNS from canonical file, or fall back to hard-coded list.
VALID_PATTERNS=()
if [ -n "$_CANONICAL_FILE" ]; then
    while IFS='|' read -r slug emoji desc; do
        # Skip comment and blank lines.
        [[ "$slug" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${slug// }" ]] && continue
        slug="${slug// /}"
        emoji="${emoji// /}"
        # Build pattern: ^<emoji> <slug>(<scope>)?!?: (scope and ! are optional)
        VALID_PATTERNS+=("^${emoji} ${slug}(\([a-z0-9_/-]+\))?!?: ")
    done < "$_CANONICAL_FILE"
fi

# Fallback: if canonical file was not found or produced no patterns, use hard-coded list.
if [ ${#VALID_PATTERNS[@]} -eq 0 ]; then
    VALID_PATTERNS=(
        "^✨ feat(\([a-z0-9_/-]+\))?!?: "
        "^🐛 fix(\([a-z0-9_/-]+\))?!?: "
        "^📚 docs(\([a-z0-9_/-]+\))?!?: "
        "^💄 style(\([a-z0-9_/-]+\))?!?: "
        "^♻️ refactor(\([a-z0-9_/-]+\))?!?: "
        "^⚡ perf(\([a-z0-9_/-]+\))?!?: "
        "^🧪 test(\([a-z0-9_/-]+\))?!?: "
        "^🔧 build(\([a-z0-9_/-]+\))?!?: "
        "^🧹 chore(\([a-z0-9_/-]+\))?!?: "
        "^📋 plan(\([a-z0-9_/-]+\))?!?: "
        "^🔒 security(\([a-z0-9_/-]+\))?!?: "
        "^🗃️ migration(\([a-z0-9_/-]+\))?!?: "
        "^📦 deps(\([a-z0-9_/-]+\))?!?: "
        "^🚀 deploy(\([a-z0-9_/-]+\))?!?: "
        "^🤖 ci(\([a-z0-9_/-]+\))?!?: "
        "^🔥 remove(\([a-z0-9_/-]+\))?!?: "
        "^🩹 hotfix(\([a-z0-9_/-]+\))?!?: "
        "^🔀 merge(\([a-z0-9_/-]+\))?!?: "
        "^🔍 debug(\([a-z0-9_/-]+\))?!?: "
        "^🔙 revert(\([a-z0-9_/-]+\))?!?: "
        "^🌐 i18n(\([a-z0-9_/-]+\))?!?: "
    )
fi

show_format_help() {
    echo "" >&2
    echo -e "${YELLOW}Required format:${NC} <emoji> <type>[(scope)][!]: <description>" >&2
    echo "" >&2
    if [ -n "$_CANONICAL_FILE" ]; then
        echo "Valid types & emojis (from templates/commit-types.txt):" >&2
        while IFS='|' read -r slug emoji desc; do
            [[ "$slug" =~ ^[[:space:]]*# ]] && continue
            [[ -z "${slug// }" ]] && continue
            printf "  %s %-12s %s\n" "${emoji// /}" "${slug// /}:" "${desc// /}" >&2
        done < "$_CANONICAL_FILE"
    else
        echo "Valid types & emojis:" >&2
        # Consumer repos have no templates/commit-types.txt — print the real list
        # rather than a command that resolves to nothing (PR #1972 review).
        echo "  ✨ feat       🐛 fix        📚 docs       💄 style" >&2
        echo "  ♻️ refactor   ⚡ perf       🧪 test       🔧 build" >&2
        echo "  🧹 chore      📋 plan       🔒 security   🗃️ migration" >&2
        echo "  📦 deps       🚀 deploy     🤖 ci         🔥 remove" >&2
        echo "  🩹 hotfix     🔀 merge      🔍 debug      🔙 revert" >&2
        echo "  🌐 i18n" >&2
    fi
    echo "" >&2
    echo -e "${GREEN}Examples:${NC}" >&2
    echo "  ✨ feat: add user authentication" >&2
    echo "  🐛 fix(api): handle null response from /users" >&2
    echo "  ♻️ refactor(auth)!: drop legacy token format" >&2
    echo "" >&2
}

VALID_FORMAT=false
for pattern in "${VALID_PATTERNS[@]}"; do
    if echo "$FIRST_LINE" | grep -qE "$pattern"; then
        VALID_FORMAT=true
        break
    fi
done

if [ "$VALID_FORMAT" = false ]; then
    echo "" >&2
    echo -e "${RED}ERROR: Invalid commit message format!${NC}" >&2
    echo "" >&2
    echo "Your message: $FIRST_LINE" >&2
    show_format_help
    exit 1
fi

#
# 3. Extract description (strip emoji, type, optional scope, optional !, colon, spaces)
#
# Build type alternation from canonical file for description extraction.
if [ -n "$_CANONICAL_FILE" ]; then
    _TYPE_REGEX=$(grep -v '^#' "$_CANONICAL_FILE" | grep -v '^[[:space:]]*$' | cut -d'|' -f1 | tr -d ' ' | paste -sd'|' -)
else
    _TYPE_REGEX="feat|fix|docs|style|refactor|perf|test|build|chore|plan|security|migration|deps|deploy|ci|remove|hotfix|merge|debug|revert|i18n"
fi
DESCRIPTION=$(echo "$FIRST_LINE" | sed -E "s/^[^ ]+ (${_TYPE_REGEX})(\([a-z0-9_/-]+\))?!?: *//")

if [ -z "$DESCRIPTION" ]; then
    echo "" >&2
    echo -e "${RED}ERROR: Missing description after type!${NC}" >&2
    echo "" >&2
    echo "Your message: $FIRST_LINE" >&2
    echo "" >&2
    echo -e "${GREEN}Example:${NC} ✨ feat: add user authentication" >&2
    echo "" >&2
    exit 1
fi

#
# 4. Reject vague / placeholder descriptions
#
DESC_LOWER=$(echo "$DESCRIPTION" | tr '[:upper:]' '[:lower:]' | sed -E 's/[[:space:]]+$//')
case "$DESC_LOWER" in
    "wip"|"tmp"|"temp"|"test"|"fix"|"update"|"updates"|"updated"|"changes"|"change"|"stuff"|"things"|"asdf"|"."|".."|"..."|"misc"|"minor"|"tweak"|"tweaks"|"various"|"work"|"todo")
        echo "" >&2
        echo -e "${RED}ERROR: Description too vague: '$DESCRIPTION'${NC}" >&2
        echo "" >&2
        echo "Be specific about what changed. What does the reader need to know in 6 months?" >&2
        echo "" >&2
        exit 1
        ;;
esac

#
# 5. Subject line length (count characters, not bytes — emojis are multibyte)
#
LEN=$(printf '%s' "$FIRST_LINE" | wc -m | tr -d ' ')
if [ "$LEN" -gt 72 ]; then
    echo ""
    echo -e "${YELLOW}WARNING: Subject is ${LEN} chars (recommended ≤50, soft limit 72)${NC}"
    echo ""
    echo "Consider moving details into the commit body (after a blank line)."
    echo ""
elif [ "$LEN" -gt 50 ]; then
    echo ""
    echo -e "${YELLOW}WARNING: Subject is ${LEN} chars (recommended ≤50, soft limit 72)${NC}"
    echo ""
fi

#
# 6. No trailing period in subject (warning)
#
if [[ "$DESCRIPTION" =~ \.$ ]]; then
    echo ""
    echo -e "${YELLOW}WARNING: Drop the trailing period from the subject line${NC}"
    echo ""
fi

#
# 7. Description should start with lowercase (warning)
#
FIRST_CHAR=$(echo "$DESCRIPTION" | cut -c1)
if [[ "$FIRST_CHAR" =~ [A-Z] ]]; then
    echo ""
    echo -e "${YELLOW}WARNING: Description should start with lowercase${NC}"
    echo ""
    echo "Your message: $FIRST_LINE"
    echo ""
fi

#
# 8. If there's a body, line 2 must be blank
#
TOTAL_LINES=$(echo "$COMMIT_MSG_CLEAN" | wc -l | tr -d ' ')
if [ "$TOTAL_LINES" -gt 1 ]; then
    LINE_2=$(echo "$COMMIT_MSG_CLEAN" | sed -n '2p')
    if [ -n "$LINE_2" ]; then
        echo "" >&2
        echo -e "${RED}ERROR: Line 2 must be blank when a commit body is present${NC}" >&2
        echo "" >&2
        echo "Format:" >&2
        echo "  <subject line>" >&2
        echo "  <blank line>" >&2
        echo "  <body>" >&2
        echo "" >&2
        exit 1
    fi
fi

# All checks passed
exit 0
