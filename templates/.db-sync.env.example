# Production Database Sync Configuration
# Copy this file to .db-sync.env and fill in your credentials
# NEVER commit .db-sync.env - it contains production secrets
#
# Local DB credentials are read from the app's .env (DB_HOST, DB_PORT,
# DB_DATABASE, DB_USERNAME, DB_PASSWORD) — they are NOT configured here.
# This file is only for remote/SSH, production-DB and dev-box settings.

# Application name — used for backup file naming and local dev URL
# Defaults to the repository folder name if not set
APP_NAME=myapp

# SSH Connection (Laravel Forge)
SSH_USER=forge
SSH_HOST=your-server-ip
SSH_PORT=22
# Leave empty to use SSH agent (1Password, ssh-agent, etc.)
# Or set a path: ~/.ssh/id_rsa
SSH_KEY=

# Production Database, as reached FROM the production server.
# The dump runs THERE and only the compressed stream crosses the network, so
# these are the server's own view of the database — 127.0.0.1 for the usual
# single-box setup, or a managed/RDS endpoint it can reach.
PROD_DB_HOST=127.0.0.1
PROD_DB_PORT=3306
PROD_DB_NAME=your-db-name
PROD_DB_USER=forge
PROD_DB_PASS=your-db-password

# Tables to exclude from dump (comma-separated, no spaces)
# Leave empty to dump everything.
#
# This is the biggest lever on sync time. Find what dominates the dump with:
#   SELECT table_name, ROUND((data_length+index_length)/1048576) mb
#     FROM information_schema.tables WHERE table_schema='<db>'
#     ORDER BY 2 DESC LIMIT 10;
# A raw-webhook/audit-log table is often half the database and rarely needed
# locally — but excluding it costs you that history, so opt in deliberately.
EXCLUDE_TABLES=

# How many compressed dumps to keep in database/backups/ (rotation)
KEEP_BACKUPS=3

# ── Everything below is OPTIONAL ─────────────────────────────────────────────

# Extra mysqldump flags, additive. Default empty.
#MYSQLDUMP_EXTRA_OPTS=--column-statistics=0
# FULL override of the dump flags. The built-in defaults are MySQL 8 flags; a
# MariaDB server's mysqldump aborts on --set-gtid-purged and --no-tablespaces,
# so trim the list here when the production server runs MariaDB.
#MYSQLDUMP_OPTS=--single-transaction --quick --routines --triggers --hex-blob --default-character-set=utf8mb4 --max-allowed-packet=64M --net-buffer-length=16M --no-autocommit

# Artisan runner — plain `php artisan` works wherever php is on PATH.
#ARTISAN_CMD=herd php artisan
# Dev URL printed at the end (defaults to APP_URL from .env, else <app>.test)
#DEV_URL=https://myapp.test

# Prompt to type the database name before the irreversible DROP
#SYNC_CONFIRM=1

# ── OPTIONAL: shared dev database box ────────────────────────────────────────
# Leave DEV_DB_HOST unset and none of this runs: there is ONE restore target,
# taken from .env, and the script never rewrites .env.
#
# Set it and the box is probed on every run — it wins when BOTH its MySQL and
# its Redis answer, otherwise the target from .env is used. .env (DB_* + REDIS_*)
# is then rewritten to match the winner, so the app follows the database when you
# move between networks. Set SYNC_ENV_WRITE=0 to warn instead of rewriting.
#DEV_DB_HOST=10.0.0.55
#DEV_DB_PORT=3306
#DEV_DB_USER=devuser
#DEV_DB_PASS=your-dev-db-password
#DEV_REDIS_HOST=10.0.0.55
#DEV_REDIS_PORT=6379
#DEV_REDIS_PASS=your-dev-redis-password
#
# Explicit fallback when the dev box is unreachable. Defaults to whatever .env
# already says, which is usually what you want.
#FALLBACK_DB_HOST=127.0.0.1
#FALLBACK_DB_PORT=3306
#FALLBACK_DB_USER=root
#FALLBACK_DB_PASS=

# ── OPTIONAL: import ON the dev box instead of across the network ────────────
# mysqldump emits one statement per net_buffer_length and the importing client
# waits for the server's OK before sending the next, so importing across a link
# pays a full round trip PER STATEMENT — and pushes the whole dump uncompressed
# while doing it. Measured 15/08/2026 on a 10GbE LAN showing 0.46 ms at best but
# 24 ms average and 109 ms peaks: a 3.3 GB dump took 20-30 minutes and died with
# `ERROR 2013 ... Lost connection` at a different line each run.
#
# With DEV_SSH_HOST set, the compressed archive is shipped to that box and
# imported over its own MySQL socket instead: ~300 MB moved rather than 3.3 GB,
# and the same sync finished in ~3 minutes.
#
# Falls back to the network import by itself if anything is missing (no SSH key,
# no zstd, renamed container), so it is safe to leave configured.
#DEV_SSH_HOST=ryzen        # ssh alias/host for the dev box
#DEV_MYSQL_DOCKER=mysql    # container running MySQL; empty = native client on PATH
#DEV_TMP_DIR=/tmp          # where the archive lands there (removed after import)
#REMOTE_IMPORT=0           # force the over-the-network import
